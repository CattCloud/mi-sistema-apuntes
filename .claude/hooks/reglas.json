{
  "modo": "avisar",
  "alcance": [
    "apuntes/",
    "contexto/plan_estudio/",
    "sistema/perfil/",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "NOTAS.md"
  ],
  "excluir": ["_input/", "notion/", "_archivo/", ".claude/"],
  "omitir_por_ahora": {
    "motivo": "Apuntes escritos antes de las reglas actuales (2026-06). Se revisan cuando se retomen; quitar la ruta de esta lista en ese momento.",
    "rutas": ["apuntes/ia/"]
  },
  "estado_duplicado": {
    "regla": "R1",
    "solo_fuera_de": "apuntes/",
    "patrones": ["Siguiente paso al retomar", "Pausado en P3", "Sección \\d+ de \\d+", "Estado de T9"]
  },
  "datos_sensibles": {
    "regla": "R9",
    "patrones": ["arn:aws:[^\\s`]*:(?!123456789012|111122223333)\\d{12}", "\\bAKIA[0-9A-Z]{16}\\b", "\\b\\d{4}-\\d{4}-\\d{4}\\b", "\\b(?!123456789012\\b)\\d{12}\\.signin\\.aws\\.amazon\\.com"]
  },
  "frases_prohibidas": [
    { "regla": "A6", "motivo": "segunda persona biográfica", "patron": "como ya viste|como vimos|lo que hiciste en|has estado usando|que ya conoces", "tipos": ["seccion"] }
  ],
  "seccion": {
    "campos": ["tema", "workspace", "seccion", "titulo", "estado", "prev", "next"],
    "llevarte": { "patron": "^## .*Lo que debiste llevarte", "min": 3, "max": 7 },
    "titulos_prohibidos": "^#{1,3} .*\\b(Conclusión|Resumen|Próximos pasos)\\b"
  },
  "indice": {
    "campos": ["tema", "workspace", "estado"],
    "estados": ["EN PROGRESO", "PAUSADO", "FINALIZADO"]
  },
  "cierre": {
    "que_mide": "\\*\\*Qué mide:\\*\\*"
  }
}
